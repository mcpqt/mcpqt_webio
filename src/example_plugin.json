{
    "Tools": {
        "QString ExamplePlugin::hello(QString)": {
            "name": "example/hello",
            "title": "Hello",
            "description": "Return a friendly greeting.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Who to greet (default: world)."
                    }
                }
            }
        },
        "double ExamplePlugin::add(double,double)": {
            "name": "example/add",
            "title": "Add",
            "description": "Return a + b.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "a": { "type": "number", "description": "left operand" },
                    "b": { "type": "number", "description": "right operand" }
                },
                "required": ["a", "b"]
            }
        },
        "QVariant ExamplePlugin::info()": {
            "name": "example/info",
            "title": "Plugin info",
            "description": "Return structured information about the plugin.",
            "inputSchema": {
                "type": "object",
                "properties": {}
            }
        }
    },
    "Resources": {
        "example://info": {
            "name": "example-info",
            "title": "Example info",
            "description": "JSON metadata exposed as a resource.",
            "mimeType": "application/json",
            "signature": "QString ExamplePlugin::readInfo(QString)"
        }
    }
}